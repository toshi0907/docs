---
import { Icon } from '@astrojs/starlight/components';
import type { ComponentProps } from 'astro/types';

interface Props {
	title: string;
	description: string;
	href: string;
	icon: ComponentProps<typeof Icon>['name'];
}

const { title, description, href, icon } = Astro.props;
const url = import.meta.env.BASE_URL.replace(/\/$/, '') + href;
---

<a class="doc-card not-content" href={url}>
	<span class="doc-card-icon"><Icon name={icon} size="1.5rem" /></span>
	<span class="doc-card-body">
		<span class="doc-card-title">{title}</span>
		<span class="doc-card-desc">{description}</span>
	</span>
	<Icon name="right-arrow" class="doc-card-arrow" size="1.25rem" />
</a>

<style>
	.doc-card {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem 1.125rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background: var(--sl-color-black);
		color: var(--sl-color-white);
		text-decoration: none;
		box-shadow: var(--sl-shadow-sm);
		transition:
			border-color 0.15s ease,
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}
	.doc-card:hover,
	.doc-card:focus-visible {
		border-color: var(--sl-color-accent);
		transform: translateY(-2px);
		box-shadow: var(--sl-shadow-md);
	}
	.doc-card-icon {
		display: grid;
		place-items: center;
		flex: none;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.625rem;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
	}
	.doc-card-body {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		min-width: 0;
	}
	.doc-card-title {
		font-weight: 600;
		font-size: var(--sl-text-lg);
		line-height: 1.4;
	}
	.doc-card-desc {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
	}
	.doc-card-arrow {
		margin-inline-start: auto;
		flex: none;
		color: var(--sl-color-gray-3);
	}
	.doc-card:hover .doc-card-arrow {
		color: var(--sl-color-accent-high);
	}
</style>
